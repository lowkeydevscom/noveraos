# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/noveraos?schema=public"

# Auth.js / NextAuth Secret
AUTH_SECRET="your_production_auth_secret_here"

# OpenAI API Key (for embeddings & RAG synthesis)
OPENAI_API_KEY="sk-proj-your-openai-api-key"

# Sentry Error Monitoring DSN
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# Private Beta Cohort Access Control (comma separated)
ALLOWED_BETA_EMAILS="demo@noveraos.local,beta@noveraos.local,tester@noveraos.local"

# Environment
NODE_ENV="development"
